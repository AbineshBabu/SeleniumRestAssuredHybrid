{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "createdAt": {"type": "number"},
    "data": {
      "type": "object",
      "properties": {
        "year": {"type": "integer"},
        "price": {"type": "integer"},
        "CPU model": {"type": "string"},
        "Hard disk size": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "required": ["id","name","createdAt","data"],
  "additionalProperties": false
}